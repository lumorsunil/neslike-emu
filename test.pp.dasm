    processor 6502
    org $D000

)§
utils = await import("./pp-utils.js")
controls = await import("./controls.js")
music = await import("./music.js")
graphics = await import("./graphics.js")
objects = await import("./objects.js")
)§

    include "neslike.inc"

main:

)§ emit(graphics.init()) )§
)§ emit(objects.init()) )§

; TODO: Eat apple
; TODO: Snake body
; TODO: Game over
; TODO: Score
; TODO: Sound effects
frame:

)§ emit(controls.instructions()) )§
)§ emit(music.instructions()) )§

end:
    sta VSYNC
    jmp frame

ram:
)§ emit(controls.data()) )§
)§ emit(music.data()) )§
)§ emit(graphics.data()) )§

temp:
    byte 0

subroutines:
)§ emit(objects.subroutines()) )§
